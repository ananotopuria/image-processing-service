{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ],
    "^.+\\.js$": "<rootDir>/jest-commonjs-transformer.cjs"
  },
  "transformIgnorePatterns": ["/node_modules/(?!@nestjs/)"]
}
