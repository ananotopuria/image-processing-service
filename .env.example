PORT=3000
# Comma-separated exact frontend origins; no trailing slash or paths.
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/image_processing_service?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=1h

AWS_REGION=eu-north-1
AWS_S3_BUCKET=anano-image-processing-service-2026
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
